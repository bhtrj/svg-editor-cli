# §6.1 版本 B：用复合图形 box 重写同一张流程图。
# box 是插件类型（§4.4），所以要带上 --plugin box 运行：
#   npm run flowchart-box
init 800 600

create box n1 120 100 160 60 "开始"
create box n2 520 100 160 60 "处理数据"
create line arrow1 280 130 520 130 black
group flowchart n1 n2 arrow1

# Composite 的统一操作：对 box 与对普通图形毫无区别
move n2 0 100
undo
set n2 fill #f5a623
set n2 label "处理数据 v2"
undo

tree
save examples/flowchart-box.svg
